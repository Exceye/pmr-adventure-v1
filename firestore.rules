rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Satu dokumen per pemain (ID = nama), menyimpan skor terbaik.
    match /leaderboard/{playerId} {
      // Siapa pun boleh melihat leaderboard.
      allow read: if true;

      // Data harus berbentuk { name, score, updatedAt } dan masuk akal.
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'score', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 14
          && d.score is int && d.score >= 0 && d.score <= 90
          && d.updatedAt == request.time;
      }

      allow create: if validData();
      // Skor hanya boleh naik, tidak boleh diturunkan.
      allow update: if validData() && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }
  }
}
